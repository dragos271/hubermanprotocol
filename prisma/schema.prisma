
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  emailVerified DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  protocols Protocol[]
  accounts  Account[]
  sessions  Session[]
  dailyLogs DailyAnchorLog[]
  metrics   MetricCheckIn[]
  digestSettings DigestSettings?
  milestones ProgressMilestone[]
  goalMetricPreferences GoalMetricPreference[]
}

model Protocol {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  sessionToken String?
  goals     Json
  plan      Json
  metadata  Json?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  dailyLogs DailyAnchorLog[]
  metrics   MetricCheckIn[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum AnchorSlot {
  morning
  daytime
  evening
}

enum MetricType {
  sleep_latency
  sleep_quality
  energy_stability
  focus_blocks
  mood_state
  stress_load
}

enum DigestCadence {
  weekly
  biweekly
  monthly
}

model DailyAnchorLog {
  id          String    @id @default(cuid())
  userId      String?
  protocolId  String?
  date        DateTime
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  protocol    Protocol? @relation(fields: [protocolId], references: [id], onDelete: SetNull)
  completions AnchorCompletion[]
  metrics     MetricCheckIn[]

  @@unique([userId, date])
}

model AnchorCompletion {
  id           String     @id @default(cuid())
  logId        String
  slot         AnchorSlot
  anchorText   String
  completed    Boolean    @default(false)
  completedAt  DateTime?
  evidenceLink String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  log          DailyAnchorLog @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([slot])
}

model MetricCheckIn {
  id          String      @id @default(cuid())
  userId      String?
  protocolId  String?
  logId       String?
  goalId      String?
  metric      MetricType
  value       Int
  notes       String?
  recordedAt  DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  protocol    Protocol?   @relation(fields: [protocolId], references: [id], onDelete: SetNull)
  log         DailyAnchorLog? @relation(fields: [logId], references: [id], onDelete: SetNull)

  @@index([metric])
  @@index([goalId])
  @@index([recordedAt])
}

model DigestSettings {
  id         String        @id @default(cuid())
  userId     String        @unique
  cadence    DigestCadence @default(weekly)
  enabled    Boolean       @default(true)
  lastSentAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProgressMilestone {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  metadata    Json?
  achievedAt  DateTime @default(now())
  dismissedAt DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, achievedAt])
}

model GoalMetricPreference {
  id        String     @id @default(cuid())
  userId    String
  goalId    String
  metric    MetricType
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, goalId, metric])
}
